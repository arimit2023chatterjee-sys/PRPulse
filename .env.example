# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# LLM Provider Configuration ("gemini", "openai", or "mock")
# In "mock" mode, offline rule-based backend analysis runs without needing any API key!
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI Provider
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub Webhook & API Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here
GITHUB_API_BASE=https://api.github.com
AUTO_POST_TO_GITHUB=false

# Database Configuration (SQLite default, PostgreSQL/Supabase supported)
DATABASE_URL=sqlite:///./pr_reviewer.db

# Static Analysis & Guardrails
ENABLE_RUFF=true
MAX_DIFF_FILES=40
MAX_DIFF_BYTES=600000

